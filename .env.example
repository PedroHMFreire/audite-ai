# Copie para ".env" (não versionado) e preencha.
# Tudo que começa com VITE_ vai embutido no JavaScript público do site:
# NUNCA coloque aqui chave secreta, senha de banco ou chave do Stripe.

# Supabase: Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_publica

# Opcional: valor exibido na tela (a cobrança real é a do preço no Stripe)
VITE_PLAN_PRICE_LABEL=R$ 59

# Opcional: e-mail de suporte exibido no app
VITE_SUPPORT_EMAIL=contato@rakaimidia.com

# --- Só para a linha de comando (arquivo .env.local, nunca .env) ---
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
#
# As chaves do Stripe NÃO ficam em arquivo: são gravadas no Supabase com
# "supabase secrets set". Veja docs/ATIVAR_COBRANCA_STRIPE.md.
