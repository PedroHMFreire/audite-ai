{
  "name": "audite-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode localdb --port 5180 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "node --test tests/billing-logic.test.mjs tests/spreadsheet.test.mjs",
    "test:db": "node --test tests/db-security.test.mjs tests/billing-functions.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "test:all": "npm test && npm run test:db && npm run test:e2e",
    "pwa:icons": "node scripts/generate-pwa-icons.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.5",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.552.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.58.2",
    "postcss": "^8.4.41",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
